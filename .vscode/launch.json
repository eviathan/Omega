{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Omega.Game",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Omega.Game/bin/Debug/net9.0/Omega.Game.dll",
            "args": [
                "--vscode"
            ],
            "cwd": "${workspaceFolder}/Omega.Game",
            "console": "internalConsole",
            "stopAtEntry": false,
            "logging": {
                "moduleLoad": false,
                "diagnosticsLog": {
                    "protocolMessages": false
                },
                "exceptionLogging": "none",
                "trace": false,
                "programOutput": true
            }
        },

        {
            "name": "Attach To Process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
